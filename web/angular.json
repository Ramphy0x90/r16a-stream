{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "r16a-stream-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": { "style": "scss", "changeDetection": "OnPush" }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": [
              "@fontsource-variable/inter/wght.css",
              "@r16a-stream/design-tokens/tokens.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "550kB", "maximumError": "700kB" },
                { "type": "anyComponentStyle", "maximumWarning": "6kB", "maximumError": "10kB" }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": false
              },
              "subresourceIntegrity": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "r16a-stream-web:build:production" },
            "development": { "buildTarget": "r16a-stream-web:build:development" }
          },
          "defaultConfiguration": "development",
          "options": { "proxyConfig": "proxy.conf.mjs", "port": 4200 }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": { "tsConfig": "tsconfig.spec.json", "runner": "vitest", "buildTarget": "::development" }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": { "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"] }
        }
      }
    }
  }
}
