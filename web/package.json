{
  "name": "r16a-stream-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:csp": "playwright test e2e/csp.spec.ts",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/app/core/api/schema.d.ts && prettier --write src/app/core/api/schema.d.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@fontsource-variable/inter": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "@r16a-stream/design-tokens": "*",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
