<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app goes into cloud backups or device-to-device transfers. Tokens live in
     the keystore-backed secure storage and must not leave the device (SPEC 6.4). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
