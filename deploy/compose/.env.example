# Copy to .env (git-ignored) and replace every CHANGE_ME, then `docker compose up -d --build`.
# Generate values with the command next to each one. The services refuse placeholders.

# Postgres superuser, used only by the database container itself.  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Schema owner, migrations only.  openssl rand -hex 24
R16A_OWNER_PASSWORD=CHANGE_ME
# Runtime role of the API.  openssl rand -hex 24
R16A_APP_PASSWORD=CHANGE_ME
# Runtime role of the worker.  openssl rand -hex 24
R16A_WORKER_PASSWORD=CHANGE_ME

# Garage internals.  openssl rand -hex 32 for the RPC secret, openssl rand -hex 24 for tokens
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
GARAGE_METRICS_TOKEN=CHANGE_ME

# Garage keys. Key ids are GK plus 24 hex digits, secrets 64 hex digits.
#   echo GK$(openssl rand -hex 12)      openssl rand -hex 32
R16A_S3_ACCESS_KEY_ID=CHANGE_ME
R16A_S3_SECRET_ACCESS_KEY=CHANGE_ME
R16A_WORKER_S3_ACCESS_KEY_ID=CHANGE_ME
R16A_WORKER_S3_SECRET_ACCESS_KEY=CHANGE_ME

# Authentik, the dev providers from docs/OPERATING.md section 3.1, whose redirect URIs include
# http://localhost:8080/api/v1/auth/callback. Both issuers must be on the same Authentik.
R16A_OIDC_ISSUER=https://CHANGE_ME/application/o/r16a-stream-dev/
R16A_OIDC_WEB_CLIENT_ID=r16a-stream-dev
R16A_OIDC_WEB_CLIENT_SECRET=CHANGE_ME
R16A_OIDC_MOBILE_ISSUER=https://CHANGE_ME/application/o/r16a-stream-mobile-dev/
R16A_OIDC_MOBILE_CLIENT_ID=r16a-stream-mobile-dev
# Seals refresh tokens at rest.  openssl rand -base64 32
R16A_SESSION_KEY=CHANGE_ME

# Where the browser reaches the stack.
R16A_HTTP_PORT=8080
R16A_PUBLIC_URL=http://localhost:8080
