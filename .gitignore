# Editors. A shared extension recommendation list may be committed.
.idea/
.vscode/*
!.vscode/extensions.json

# Local configuration and secrets. Only the templates are tracked.
.env
.env.*
!.env.example
deploy/k8s/secret.yaml

# Rust
backend/target/

# Worker scratch space in manual mode
**/.scratch/

# Node. The npm workspace installs at the repository root, so node_modules can appear at
# any level.
node_modules/

# Web
web/dist/
web/.angular/
web/coverage/

