  "db_name": "PostgreSQL",
  "query": "update jobs set status = 'running', locked_by = $1, started_at = now(), heartbeat_at = now(),\n                blocked_reason = null\n         where id = (\n           select id from jobs\n           where status = 'queued' and run_after <= now() and kind = any($2)\n           order by priority desc, run_after, id\n           for update skip locked\n           limit 1)\n         returning id, kind, image_id, variant_id, payload, attempts, max_attempts, storage_waits",
