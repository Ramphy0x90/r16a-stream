  "query": "select s.is_admin, s.refresh_token_enc, s.key_id, s.user_id, u.oidc_subject,\n                extract(epoch from now() - s.claims_refreshed_at)::float8 as \"claims_age_secs!\"\n         from sessions s join users u on u.id = s.user_id\n         where s.id = $1\n         for update of s",
