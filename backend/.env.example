# Copy to backend/.env for manual mode (cargo run). backend/.env is git-ignored and is read by
# debug builds only. Production reads the real environment, see deploy/k8s.
#
# Every value below is a published dev-only credential for the containers in
# deploy/compose/docker-compose.dev.yml, which must be running. They are refused outside
# development by the startup checks.

R16A_ENV=development
RUST_LOG=info,sqlx=warn,r16a_stream_backend=debug

# The origin the browser uses. In manual mode that is ng serve, which proxies /api and the
# bucket paths, so presigned URLs are signed for it as well.
R16A_PUBLIC_URL=http://localhost:4200
R16A_S3_PUBLIC_ENDPOINT=http://localhost:4200
R16A_DEV_INSECURE_COOKIE=true
R16A_HTTP_BIND=127.0.0.1:8081

# Runtime role for the API. The migrate URL lets the API migrate itself in development only.
R16A_DATABASE_URL=postgres://r16a_stream_app:dev-only-app-password@127.0.0.1:5433/r16a_stream
R16A_MIGRATE_DATABASE_URL=postgres://r16a_stream_owner:dev-only-owner-password@127.0.0.1:5433/r16a_stream

# Authentik, providers r16a-stream-dev (web) and r16a-stream-mobile-dev (app), set up as in
# docs/OPERATING.md section 3.1. Replace the host with your Authentik instance. The client secret
# is the real secret of the dev provider, it never goes into a committed file.
R16A_OIDC_ISSUER=https://AUTHENTIK_HOST/application/o/r16a-stream-dev/
R16A_OIDC_WEB_CLIENT_ID=r16a-stream-dev
R16A_OIDC_WEB_CLIENT_SECRET=
R16A_OIDC_MOBILE_ISSUER=https://AUTHENTIK_HOST/application/o/r16a-stream-mobile-dev/
R16A_OIDC_MOBILE_CLIENT_ID=r16a-stream-mobile-dev
# Seals refresh tokens at rest. This published value is refused outside development.
R16A_SESSION_KEY=BwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyAhIiMkJSY=

R16A_S3_INTERNAL_ENDPOINTS=http://127.0.0.1:3900
R16A_S3_ACCESS_KEY_ID=GKe781357014cf1870ce72ffb3
R16A_S3_SECRET_ACCESS_KEY=9be2320de5bf8e5b07297443f66bcb7ac546fee5bf2c3f91d7c070e385a43d99

# Worker. `cargo run --bin worker` reads this same file, so the worker's database role and
# Garage key have their own variables and the API's are never used by it.
R16A_WORKER_DATABASE_URL=postgres://r16a_stream_worker:dev-only-worker-password@127.0.0.1:5433/r16a_stream
R16A_WORKER_HEALTH_BIND=127.0.0.1:8082
R16A_WORKER_S3_ACCESS_KEY_ID=GKb21e6a01028af364e9ab7821
R16A_WORKER_S3_SECRET_ACCESS_KEY=115f67a9ad320bb660d52232aad8eeb83be06e0f5ca9accae166c5572af89c69
R16A_WORKER_SCRATCH_DIR=./.scratch

# sqlx query macros check SQL against the committed .sqlx cache, so building needs no database.
SQLX_OFFLINE=true
