  "contrastPairs": [
    { "fg": "text", "bg": "surface", "min": 4.5, "use": "body text" },
    { "fg": "text", "bg": "surface-raised", "min": 4.5, "use": "text on cards" },
    { "fg": "text", "bg": "surface-sunken", "min": 4.5, "use": "text in inputs" },
    { "fg": "text-muted", "bg": "surface", "min": 4.5, "use": "secondary text" },
    { "fg": "text-muted", "bg": "surface-raised", "min": 4.5, "use": "secondary text on cards" },
    { "fg": "text-on-brand", "bg": "brand-fill", "min": 4.5, "use": "primary button label" },
    { "fg": "text-on-brand", "bg": "brand-fill-hover", "min": 4.5, "use": "primary button label, hover" },
    { "fg": "text-on-danger", "bg": "danger-fill", "min": 4.5, "use": "danger button label" },
    { "fg": "brand-text", "bg": "surface", "min": 4.5, "use": "links" },
    { "fg": "brand-text", "bg": "surface-raised", "min": 4.5, "use": "links on cards" },
    { "fg": "danger-text", "bg": "surface", "min": 4.5, "use": "error messages" },
    { "fg": "success-text", "bg": "surface", "min": 4.5, "use": "success messages" },
    { "fg": "warning-text", "bg": "surface", "min": 4.5, "use": "warning messages" },
    { "fg": "info-text", "bg": "surface", "min": 4.5, "use": "info messages" },
    { "fg": "focus-ring", "bg": "surface", "min": 3, "use": "focus indicator, non-text" },
    { "fg": "border-strong", "bg": "surface", "min": 3, "use": "input borders, non-text" },
    { "fg": "brand-fill", "bg": "surface", "min": 3, "use": "button shape, non-text" }
  ]
